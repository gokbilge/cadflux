{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@mlightcad/cad-viewer": ["src/shims.d.ts"],
      "@mlightcad/cad-simple-viewer": ["src/shims.d.ts"],
      "@mlightcad/cad-svg-plugin/register": ["src/shims.d.ts"],
      "@mlightcad/cad-pdf-plugin/register": ["src/shims.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
