{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "lib": ["ES2022", "DOM"],
    "paths": {}
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/cadflux-editor/**/*.ts",
