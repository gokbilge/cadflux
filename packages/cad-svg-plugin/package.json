{
  "name": "@mlightcad/cad-svg-plugin",
  "version": "1.5.8",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-svg-plugin.umd.cjs",
  "module": "./dist/cad-svg-plugin.js",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "command": [
        "lib/AcApConvertToSvgCmd.d.ts"
      ],
      "convertor": [
        "lib/AcApSvgConvertor.d.ts"
      ],
      "factory": [
        "lib/createSvgPlugin.d.ts"
      ],
      "plugin": [
        "lib/AcApSvgPlugin.d.ts"
      ],
      "register": [
        "lib/register.d.ts"
      ],
      "renderer": [
        "lib/AcSvgRenderer.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-svg-plugin.js",
      "require": "./dist/cad-svg-plugin.umd.cjs"
    },
    "./command": {
      "types": "./lib/AcApConvertToSvgCmd.d.ts",
      "import": "./dist/cad-svg-plugin-command.js",
      "require": "./dist/cad-svg-plugin-command.umd.cjs"
    },
    "./convertor": {
      "types": "./lib/AcApSvgConvertor.d.ts",
      "import": "./dist/cad-svg-plugin-convertor.js",
      "require": "./dist/cad-svg-plugin-convertor.umd.cjs"
    },
    "./factory": {
      "types": "./lib/createSvgPlugin.d.ts",
      "import": "./dist/cad-svg-plugin-factory.js",
      "require": "./dist/cad-svg-plugin-factory.umd.cjs"
    },
    "./plugin": {
      "types": "./lib/AcApSvgPlugin.d.ts",
      "import": "./dist/cad-svg-plugin-plugin.js",
      "require": "./dist/cad-svg-plugin-plugin.umd.cjs"
    },
    "./register": {
      "types": "./lib/register.d.ts",
      "import": "./dist/cad-svg-plugin-register.js",
      "require": "./dist/cad-svg-plugin-register.umd.cjs"
    },
    "./renderer": {
      "types": "./lib/AcSvgRenderer.d.ts",
      "import": "./dist/cad-svg-plugin-renderer.js",
      "require": "./dist/cad-svg-plugin-renderer.umd.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@cadflux/core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "^1.12.1",
    "@mlightcad/mtext-parser": "^1.4.1",
    "@mlightcad/mtext-renderer": "^0.12.1"
  },
  "peerDependencies": {
    "@cadflux/core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "^1.12.1",
    "@mlightcad/mtext-parser": "^1.4.1",
    "@mlightcad/mtext-renderer": "^0.12.1"
  }
}
