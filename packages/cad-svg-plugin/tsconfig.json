{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "baseUrl": "./src",
    "paths": {
      "@cadflux/core": [
        "../../core/dist/index.d.ts"
      ],
      "@mlightcad/cad-svg-plugin": [
        "./index.ts"
      ],
      "@mlightcad/cad-svg-plugin/command": [
        "./AcApConvertToSvgCmd.ts"
      ],
      "@mlightcad/cad-svg-plugin/convertor": [
        "./AcApSvgConvertor.ts"
