      "@mlightcad/cad-svg-plugin/factory": [
        "./createSvgPlugin.ts"
      ],
      "@mlightcad/cad-svg-plugin/plugin": [
        "./AcApSvgPlugin.ts"
      ],
      "@mlightcad/cad-svg-plugin/register": [
        "./register.ts"
      ],
      "@mlightcad/cad-svg-plugin/renderer": [
        "./AcSvgRenderer.ts"
      ]
    }
  },
  "include": [
    "src"
