{
  "name": "@mlightcad/cad-pdf-plugin",
  "version": "1.5.8",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlightcad/cad-viewer.git"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "package.json"
  ],
  "main": "./dist/cad-pdf-plugin.umd.cjs",
  "module": "./dist/cad-pdf-plugin.js",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      "command": [
        "lib/AcApConvertToPdfCmd.d.ts"
      ],
      "convertor": [
        "lib/AcApPdfConvertor.d.ts"
      ],
      "factory": [
        "lib/createPdfPlugin.d.ts"
      ],
      "import-command": [
        "lib/AcApImportPdfCmd.d.ts"
      ],
      "import-convertor": [
        "lib/AcApPdfImportConvertor.d.ts"
      ],
      "plugin": [
        "lib/AcApPdfPlugin.d.ts"
      ],
      "register": [
        "lib/register.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/cad-pdf-plugin.js",
      "require": "./dist/cad-pdf-plugin.umd.cjs"
    },
    "./command": {
      "types": "./lib/AcApConvertToPdfCmd.d.ts",
      "import": "./dist/cad-pdf-plugin-command.js",
      "require": "./dist/cad-pdf-plugin-command.umd.cjs"
    },
    "./convertor": {
      "types": "./lib/AcApPdfConvertor.d.ts",
      "import": "./dist/cad-pdf-plugin-convertor.js",
      "require": "./dist/cad-pdf-plugin-convertor.umd.cjs"
    },
    "./factory": {
      "types": "./lib/createPdfPlugin.d.ts",
      "import": "./dist/cad-pdf-plugin-factory.js",
      "require": "./dist/cad-pdf-plugin-factory.umd.cjs"
    },
    "./import-command": {
      "types": "./lib/AcApImportPdfCmd.d.ts",
      "import": "./dist/cad-pdf-plugin-import-command.js",
      "require": "./dist/cad-pdf-plugin-import-command.umd.cjs"
    },
    "./import-convertor": {
      "types": "./lib/AcApPdfImportConvertor.d.ts",
      "import": "./dist/cad-pdf-plugin-import-convertor.js",
      "require": "./dist/cad-pdf-plugin-import-convertor.umd.cjs"
    },
    "./plugin": {
      "types": "./lib/AcApPdfPlugin.d.ts",
      "import": "./dist/cad-pdf-plugin-plugin.js",
      "require": "./dist/cad-pdf-plugin-plugin.umd.cjs"
    },
    "./register": {
      "types": "./lib/register.d.ts",
      "import": "./dist/cad-pdf-plugin-register.js",
      "require": "./dist/cad-pdf-plugin-register.umd.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf dist lib tsconfig.tsbuildinfo",
    "build": "tsc && vite build",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix --quiet src/"
  },
  "devDependencies": {
    "@cadflux/core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/cad-svg-plugin": "workspace:*",
    "@mlightcad/data-model": "^1.12.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^5.6.205",
    "svg2pdf.js": "^2.7.0"
  },
  "peerDependencies": {
    "@cadflux/core": "workspace:*",
    "@mlightcad/cad-simple-viewer": "workspace:*",
    "@mlightcad/data-model": "^1.12.1",
    "@mlightcad/cad-svg-plugin": "workspace:*"
  }
}
