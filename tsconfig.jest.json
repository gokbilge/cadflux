{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "commonjs",
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "apps/**/*.ts",
    "jest.config.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ]
}
