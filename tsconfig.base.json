{
  "compilerOptions": {
    "target": "es5",
    "module": "es2020",
    "declaration": true,
    "declarationMap": true,
    "allowJs": false,
    "sourceMap": true,

    /* Linting */
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@cadflux/auth": ["packages/auth/src/index.ts"],
      "@cadflux/core": ["packages/core/src/index.ts"],
      "@cadflux/core/browserBridge": ["packages/core/src/browserBridge.ts"],
      "@cadflux/core/checksum": ["packages/core/src/checksum.ts"],
      "@cadflux/contracts": ["packages/contracts/src/index.ts"],
      "@cadflux/database": ["packages/database/src/index.ts"],
      "@cadflux/storage": ["packages/storage/src/index.ts"],
      "@cadflux/batch-engine": ["packages/batch-engine/src/index.ts"],
      "@cadflux/diagnostics": ["packages/diagnostics/src/index.ts"],
      "@cadflux/config": ["packages/config/src/index.ts"],
      "@cadflux/cad-import": ["packages/cad-import/src/index.ts"],
      "@cadflux/drawing-model": ["packages/drawing-model/src/index.ts"],
      "@cadflux/dwg-adapter": ["packages/dwg-adapter/src/index.ts"],
      "@cadflux/dxf-adapter": ["packages/dxf-adapter/src/index.ts"],
      "@cadflux/file-ingest": ["packages/file-ingest/src/index.ts"],
      "@cadflux/file-ingest/node": ["packages/file-ingest/src/node.ts"],
      "@cadflux/plot-engine": ["packages/plot-engine/src/index.ts"],
      "@cadflux/presets": ["packages/presets/src/index.ts"],
      "@cadflux/renderer-webgl": ["packages/renderer-webgl/src/index.ts"],
      "@cadflux/renderer-svg": ["packages/renderer-svg/src/index.ts"],
      "@cadflux/renderer-pdf": ["packages/renderer-pdf/src/index.ts"],
      "@mlightcad/cad-simple-viewer": ["packages/cad-simple-viewer/src/index.ts"]
    }
  },
  "ts-node": {
    "esm": true,
  },
}
