{
  "name": "@cadflux/cli",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "cadflux": "./dist/apps/cli/src/cli.js"
  },
  "main": "./dist/apps/cli/src/cli.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json && node ../../tools/fix-esm-specifiers.mjs dist",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test:watch": "pnpm run build && node --test dist/apps/cli/src/cli.watch.test.js"
  },
  "dependencies": {
    "@cadflux/batch-engine": "workspace:*",
    "@cadflux/config": "workspace:*",
    "@cadflux/core": "workspace:*",
    "@cadflux/diagnostics": "workspace:*",
    "@cadflux/dwg-adapter": "workspace:*",
    "@cadflux/dxf-adapter": "workspace:*",
    "@cadflux/file-ingest": "workspace:*",
    "@cadflux/plot-engine": "workspace:*",
    "@cadflux/presets": "workspace:*",
    "@cadflux/renderer-pdf": "workspace:*",
    "@cadflux/renderer-svg": "workspace:*",
    "commander": "^12.1.0",
    "playwright": "^1.49.1"
  }
}
