{
  "name": "cadflux",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "author": "CadFlux contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gokbilge/cadflux"
  },
  "workspaces": [
    "apps/cli",
    "apps/server",
    "apps/web",
    "packages/auth",
    "packages/batch-engine",
    "packages/cad-import",
    "packages/cad-simple-viewer",
    "packages/config",
    "packages/contracts",
    "packages/core",
    "packages/database",
    "packages/diagnostics",
    "packages/drawing-model",
    "packages/dwg-adapter",
    "packages/dxf-adapter",
    "packages/file-ingest",
    "packages/plot-engine",
    "packages/presets",
    "packages/renderer-pdf",
    "packages/renderer-svg",
    "packages/renderer-webgl",
    "packages/storage",
    "packages/three-renderer"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "analyze": "pnpm minimize:bundle",
    "build": "pnpm build:cadflux",
    "build:cadflux": "pnpm --filter @cadflux/core build && pnpm --filter @cadflux/drawing-model build && pnpm --filter @cadflux/dwg-adapter build && pnpm --filter @cadflux/dxf-adapter build && pnpm --filter @cadflux/cad-import build && pnpm --filter @cadflux/plot-engine build && pnpm --filter @cadflux/contracts build && pnpm --filter @cadflux/auth build && pnpm --filter @cadflux/database build && pnpm --filter @cadflux/storage build && pnpm --filter @cadflux/batch-engine build && pnpm --filter @cadflux/renderer-svg build:lib && pnpm --filter @cadflux/renderer-pdf build:lib && pnpm --filter @cadflux/cli build && pnpm --filter @cadflux/server build && pnpm --filter @cadflux/web build",
    "build:cadflux:full": "pnpm run build:cadflux",
    "build:conversion-runners": "node -e \"console.log('conversion runners removed')\"",
    "build:server": "pnpm --filter @cadflux/core build && pnpm --filter @cadflux/drawing-model build && pnpm --filter @cadflux/dwg-adapter build && pnpm --filter @cadflux/dxf-adapter build && pnpm --filter @cadflux/cad-import build && pnpm --filter @cadflux/plot-engine build && pnpm --filter @cadflux/contracts build && pnpm --filter @cadflux/auth build && pnpm --filter @cadflux/database build && pnpm --filter @cadflux/storage build && pnpm --filter @cadflux/batch-engine build && pnpm --filter @cadflux/renderer-svg build && pnpm --filter @cadflux/renderer-pdf build && pnpm --filter @cadflux/server build",
    "clean": "node tools/run-workspace-script.mjs clean",
    "dev:cadflux:web": "pnpm --filter @cadflux/web dev",
    "dev:cadflux:server": "pnpm --filter @cadflux/server dev",
    "docs:build": "node tools/build-docs-site.mjs",
    "docs:site:prepare": "node tools/prepare-docs-site.mjs",
    "format": "prettier --config ./.prettierrc.js --write \"packages/**/*.{ts,js,vue,json}\"",
    "lint": "node tools/run-workspace-script.mjs lint",
    "lint:fix": "node tools/run-workspace-script.mjs lint:fix",
    "publish:cadflux": "node tools/publish-cadflux.mjs",
    "release": "node tools/release.mjs",
    "release:artifacts": "node tools/generate-release-artifacts.mjs",
    "test": "node tools/test-active-cadflux.mjs",
    "test:integration": "node tools/test-cadflux-server.mjs",
    "test:minimization": "node tools/minimization/test-minimization.mjs",
    "check:mlightcad-boundary": "node tools/minimization/check-mlightcad-boundary.mjs",
    "check:mlightcad-production": "node tools/minimization/check-mlightcad-production.mjs",
    "check:public-api-boundary": "node tools/minimization/check-public-api-boundary.mjs",
    "check:no-i18n": "node tools/minimization/check-no-i18n.mjs",
    "check:no-playwright": "node tools/minimization/check-no-playwright-runtime.mjs",
    "typecheck": "node tools/typecheck-workspaces.mjs",
    "minimize:analyze": "node tools/minimization/analyze-workspaces.mjs",
    "minimize:measure": "node tools/minimization/measure-size.mjs",
    "minimize:measure:full": "node tools/minimization/measure-size.mjs",
    "minimize:bundle": "pnpm --filter @cadflux/web analyze",
    "minimize:baseline": "pnpm minimize:analyze && pnpm minimize:measure",
    "minimize:baseline:full": "set CADFLUX_MINIMIZE_FULL=1&& pnpm minimize:analyze && pnpm minimize:measure:full",
    "doctor:server": "node apps/server/dist/apps/server/src/index.js doctor",
    "use:dwg-converter": "node tools/use-dwg-converter.mjs"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.4.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --config ./.prettierrc.js --write",
      "eslint --config ./eslint.config.js --fix --quiet"
    ],
    "*.md": [
      "prettier --config ./.prettierrc.js --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.0"
  }
}
