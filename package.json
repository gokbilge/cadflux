{
  "name": "cadflux",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "author": "CadFlux contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/gokbilge/cadflux"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "analyze": "nx run-many -t analyze",
    "build": "nx run-many -t build",
    "build:cadflux": "pnpm --filter @cadflux/core build && pnpm --filter @cadflux/dwg-adapter build && pnpm --filter @cadflux/dxf-adapter build && pnpm --filter @cadflux/plot-engine build && pnpm --filter @cadflux/contracts build && pnpm --filter @cadflux/auth build && pnpm --filter @cadflux/database build && pnpm --filter @cadflux/storage build && pnpm --filter @cadflux/batch-engine build && pnpm --filter @cadflux/renderer-svg build:lib && pnpm --filter @cadflux/renderer-pdf build:lib && pnpm --filter @cadflux/cli build && pnpm --filter @cadflux/server build && pnpm --filter @cadflux/web build",
    "build:cadflux:full": "pnpm run build:cadflux && pnpm run build:conversion-runners",
    "build:conversion-runners": "pnpm --filter @cadflux/renderer-svg build:runner && pnpm --filter @cadflux/renderer-pdf build:runner",
    "build:server": "pnpm --filter @cadflux/core build && pnpm --filter @cadflux/dwg-adapter build && pnpm --filter @cadflux/dxf-adapter build && pnpm --filter @cadflux/plot-engine build && pnpm --filter @cadflux/contracts build && pnpm --filter @cadflux/auth build && pnpm --filter @cadflux/database build && pnpm --filter @cadflux/storage build && pnpm --filter @cadflux/batch-engine build && pnpm --filter @cadflux/renderer-svg build && pnpm --filter @cadflux/renderer-pdf build && pnpm --filter @cadflux/server build",
    "clean": "nx run-many -t clean",
    "copy:workers": "pnpm -r --filter \"./packages/**\" run copy:workers",
    "dev": "nx run @mlightcad/cad-viewer-example:dev",
    "dev:cadflux:web": "pnpm --filter @cadflux/web dev",
    "dev:cadflux:server": "pnpm --filter @cadflux/server dev",
    "dev:simple": "nx run @mlightcad/cad-simple-viewer-example:dev",
    "docs:build": "typedoc --skipErrorChecking",
    "docs:site:prepare": "node tools/prepare-docs-site.mjs",
    "export:html": "nx run @mlightcad/cad-html-exporter-cli:build && node packages/cad-html-exporter-cli/dist/cli.js packages/cad-viewer-example/e2e/fixtures/minimal-line.dxf -o tmp/minimal-line.html",
    "export:html:run": "node packages/cad-html-exporter-cli/dist/cli.js",
    "export:html:setup": "pnpm --filter @mlightcad/cad-html-exporter-cli install-browser",
    "format": "prettier --config ./.prettierrc.js --write \"packages/**/*.{ts,js,vue,json}\"",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "preview": "nx run @mlightcad/cad-viewer-example:preview",
    "preview:simple": "nx run @mlightcad/cad-simple-viewer-example:preview",
    "pre-serve": "nx run @mlightcad/cad-viewer-examples:pre-serve",
    "publish:cadflux": "node tools/publish-cadflux.mjs",
    "publish:viewer": "pnpm -r publish --access public --no-git-checks",
    "release": "node tools/release.mjs",
    "release:artifacts": "node tools/generate-release-artifacts.mjs",
    "sync:versions": "node tools/sync-versions.mjs",
    "sync:versions:check": "node tools/sync-versions.mjs --check",
    "serve": "nx run @mlightcad/cad-viewer-examples:serve",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:integration": "node tools/test-cadflux-server.mjs",
    "test:e2e": "pnpm --filter @mlightcad/cad-viewer-example test:e2e",
    "doctor:server": "node apps/server/dist/apps/server/src/index.js doctor",
    "use:dwg-converter": "node tools/use-dwg-converter.mjs"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.9.1",
    "@intlify/eslint-plugin-vue-i18n": "^3.0.0",
    "@nx/js": "20.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.7",
    "nx": "20.0.4",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "ts-jest": "^29.1.5",
    "typedoc": "^0.28.18",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.4.0",
    "vite": "^6.4.3",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --config ./.prettierrc.js --write",
      "eslint --config ./.eslintrc.js --fix --quiet"
    ],
    "*.md": [
      "prettier --config ./.prettierrc.js --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@sinclair/typebox": "^0.34.52",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.0"
  }
}
